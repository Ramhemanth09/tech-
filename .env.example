# ==========================================
# Preowned Tech Buying Companion Configuration
# ==========================================

# Server & Network
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=dev_session_secret_change_in_production_min_32_chars_long

# Database (MongoDB Atlas)
# Leave empty or set to auto-start in-memory MongoDB for local testing.
# For Atlas, paste your connection string: mongodb+srv://<username>:<password>@cluster0.mongodb.net/tech_companion?retryWrites=true&w=majority
MONGODB_URI=

# Email Service (SMTP)
# Leave empty in development to use safe console logging of verification links and tokens.
# To use real SMTP:
EMAIL_SERVICE_HOST=smtp.gmail.com
EMAIL_SERVICE_PORT=587
EMAIL_SERVICE_USER=
EMAIL_SERVICE_PASSWORD=
EMAIL_FROM="Tech Companion" <noreply@techcompanion.local>

# AI Provider Configuration
# Supported providers: gemini | openai | fallback (default: fallback or gemini if key present)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768
VECTOR_INDEX_NAME=vector_index

# File Storage & Evidence Protection
FILE_STORAGE_PROVIDER=local
PRIVATE_FILE_STORAGE_CONFIGURATION={"uploadDir":"uploads/evidence"}
SIGNED_URL_TTL_SECONDS=3600
